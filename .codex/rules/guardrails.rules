prefix_rule(
    pattern = ["git", "push"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules forbid agents from pushing; leave the local diff for a human to push.",
    match = ["git push origin master", "git push --force"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules forbid git reset --hard and commands that rewrite history or discard work; use git diff to inspect changes.",
    match = ["git reset --hard", "git reset --hard HEAD"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

prefix_rule(
    pattern = ["git", "clean"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules forbid git clean and commands that discard work; use git status to inspect untracked files.",
    match = ["git clean -fd", "git clean -fdx"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

prefix_rule(
    pattern = ["gh", "pr", ["create", "merge"]],
    decision = "forbidden",
    justification = "AGENTS.md Git rules forbid agents from opening or merging pull requests; leave these actions to a human.",
    match = ["gh pr create", "gh pr merge 5"],
    not_match = ["gh pr view 5", "bun run verify"],
)

prefix_rule(
    pattern = ["vercel"],
    decision = "forbidden",
    justification = "AGENTS.md Security rules forbid vercel and deploy commands; leave deployment to a human.",
    match = ["vercel", "vercel deploy --prod"],
    not_match = ["git status", "bun run verify"],
)

prefix_rule(
    pattern = ["bunx", "vercel"],
    decision = "forbidden",
    justification = "AGENTS.md Security rules forbid vercel and deploy commands, including through bunx; leave deployment to a human.",
    match = ["bunx vercel", "bunx vercel deploy --prod"],
    not_match = ["git status", "bun run verify"],
)

prefix_rule(
    pattern = ["npx", "vercel"],
    decision = "forbidden",
    justification = "AGENTS.md Security rules forbid vercel and deploy commands, including through npx; leave deployment to a human.",
    match = ["npx vercel", "npx vercel deploy --prod"],
    not_match = ["git status", "bun run verify"],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules reserve commits for humans; leave a reviewable local diff.",
    match = ["git commit", "git commit -m fix", "git commit --amend"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules reserve tags for humans; agents never create tags.",
    match = ["git tag v1.0.0", "git tag -a v1.0.0 -m release"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

prefix_rule(
    pattern = ["git", "rebase"],
    decision = "forbidden",
    justification = "AGENTS.md Git rules forbid history rewriting; leave branch integration to a human.",
    match = ["git rebase master", "git rebase -i HEAD~2"],
    not_match = ["git status", "git diff", "git log", "bun run verify"],
)

# Supabase audit: bun.lock pins CLI 3.0.0; checked bunx supabase <cmd> --help.
# v3 db/migration/gen types/inspect/storage/seed/test targets default to LOCAL;
# hosted-only administration defaults to the LINKED project where applicable.
# Block hosted-capable prefixes broadly except repo-required local reset, lint
# and type generation. Local-only migration new, functions new/serve, db start,
# declarative sync, init/start/stop/status and the db:* scripts remain available.
#
# Prefix rules compare literal tokens, not suffixes or globs. For the three
# preserved subcommands, target flags below must be separate tokens immediately
# after the subcommand. --remote=<ref|branch|url> (also legacy --flag=value),
# target flags after other options/positionals, and global options inserted before
# command prefixes are NOT comprehensively blocked. These forms remain forbidden
# by policy; do not treat an unmatched command as permission to use a hosted DB.
# --linked/--db-url/--project-id are retained defensively for older CLI syntax;
# v3 help uses --remote. There are deliberately no pretend wildcard tokens.

prefix_rule(
    pattern = ["supabase", ["backups", "bootstrap", "branches", "config", "domains", "encryption", "link", "network-bans", "network-restrictions", "notebooks", "orgs", "postgres-config", "projects", "pull", "secrets", "snippets", "ssl-enforcement", "sso", "vanity-subdomains"]],
    decision = "forbidden",
    justification = "Hosted project/account administration is forbidden, including commands that default to the linked project; use the local Supabase repository scripts.",
    match = [
        "supabase backups list", "supabase bootstrap", "supabase branches list", "supabase config push",
        "supabase domains get", "supabase encryption get-root-key", "supabase link",
        "supabase network-bans get", "supabase network-restrictions get", "supabase notebooks pull",
        "supabase orgs list", "supabase postgres-config get", "supabase projects list", "supabase pull",
        "supabase secrets list", "supabase snippets list", "supabase ssl-enforcement get",
        "supabase sso list", "supabase vanity-subdomains get",
    ],
    not_match = [
        "supabase start", "supabase stop", "supabase status", "supabase migration new add_reviews",
        "supabase gen types --lang typescript", "supabase db reset", "supabase db lint", "bun run db:start",
        "bun run db:stop", "bun run db:status", "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", ["inspect", "seed", "storage"]],
    decision = "forbidden",
    justification = "These command families can target hosted projects and have no required local use in this repository; use the local Supabase repository scripts.",
    match = [
        "supabase inspect db table-stats", "supabase inspect report", "supabase seed buckets",
        "supabase storage ls",
    ],
    not_match = [
        "supabase start", "supabase stop", "supabase status", "supabase migration new add_reviews",
        "supabase gen types --lang typescript", "supabase db reset", "supabase db lint", "bun run db:start",
        "bun run db:stop", "bun run db:status", "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "functions", ["list", "delete", "download", "deploy"]],
    decision = "forbidden",
    justification = "Hosted Edge Function operations are forbidden, including the default linked project; use functions new or functions serve locally.",
    match = [
        "supabase functions list", "supabase functions delete example",
        "supabase functions download example", "supabase functions deploy example",
    ],
    not_match = [
        "supabase functions new example", "supabase functions serve", "supabase start", "supabase stop",
        "supabase status", "supabase migration new add_reviews", "supabase gen types --lang typescript",
        "supabase db reset", "supabase db lint", "bun run db:start", "bun run db:stop", "bun run db:status",
        "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "db", ["advisors", "diff", "dump", "pull", "push", "query"]],
    decision = "forbidden",
    justification = "Database dumps and these hosted-capable database commands are forbidden in every target mode; use db reset, db lint and db:types locally.",
    match = [
        "supabase db advisors", "supabase db diff --remote=example", "supabase db dump", "supabase db pull",
        "supabase db push", "supabase db query --read-only 'select 1'",
    ],
    not_match = [
        "supabase db reset", "supabase db lint", "supabase db start", "supabase db schema declarative sync",
        "supabase gen types --lang typescript", "bun run db:start", "bun run db:stop", "bun run db:status",
        "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", ["migration", "migrations"], ["list", "repair", "squash", "up", "down", "fetch"]],
    decision = "forbidden",
    justification = "Hosted-capable migration history operations are forbidden, including the migrations alias; create migration files locally and apply them with bun run db:reset.",
    match = [
        "supabase migration list", "supabase migration repair", "supabase migration squash",
        "supabase migration up", "supabase migration down", "supabase migration fetch",
        "supabase migrations list", "supabase migrations repair", "supabase migrations squash",
        "supabase migrations up", "supabase migrations down", "supabase migrations fetch",
    ],
    not_match = [
        "supabase migration new add_reviews", "supabase migrations new add_reviews", "supabase db reset",
        "bun run db:start", "bun run db:stop", "bun run db:status", "bun run db:reset", "bun run db:types",
        "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "db", "schema", "declarative", "generate"],
    decision = "forbidden",
    justification = "Declarative schema generation can read hosted databases and is not required locally here; use local migration files and bun run db:reset.",
    match = [
        "supabase db schema declarative generate",
        "supabase db schema declarative generate --schema public --remote=example",
    ],
    not_match = [
        "supabase db schema declarative sync", "supabase db reset", "supabase gen types --lang typescript",
        "bun run db:start", "bun run db:stop", "bun run db:status", "bun run db:reset", "bun run db:types",
        "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "test", "db"],
    decision = "forbidden",
    justification = "CLI pgTAP execution can target hosted databases and is not required here; use the repository test scripts against local Supabase.",
    match = [
        "supabase test db", "supabase test db tests/database --remote=example",
    ],
    not_match = [
        "supabase test new review_test", "supabase db reset", "supabase gen types --lang typescript",
        "bun run db:start", "bun run db:stop", "bun run db:status", "bun run db:reset", "bun run db:types",
        "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "db", ["lint", "reset"], ["--linked", "--db-url", "--project-id", "--remote"]],
    decision = "forbidden",
    justification = "Hosted target flags are forbidden; keep db reset and db lint local, or use bun run db:reset. Prefix matching only covers a separate flag immediately after the subcommand.",
    match = [
        "supabase db lint --linked", "supabase db lint --db-url postgresql://example.invalid/postgres",
        "supabase db lint --project-id example", "supabase db lint --remote", "supabase db reset --linked",
        "supabase db reset --db-url postgresql://example.invalid/postgres",
        "supabase db reset --project-id example", "supabase db reset --remote",
    ],
    not_match = [
        "supabase db reset", "supabase db reset --no-seed", "supabase db lint",
        "supabase db lint --schema public", "bun run db:start", "bun run db:stop", "bun run db:status",
        "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

prefix_rule(
    pattern = ["supabase", "gen", "types", ["--linked", "--db-url", "--project-id", "--remote"]],
    decision = "forbidden",
    justification = "Hosted type generation is forbidden; use bun run db:types or gen types --lang typescript (local by default in CLI v3). Prefix matching only covers a separate target flag immediately after types.",
    match = [
        "supabase gen types --linked", "supabase gen types --db-url postgresql://example.invalid/postgres",
        "supabase gen types --project-id example", "supabase gen types --remote",
    ],
    not_match = [
        "supabase gen types", "supabase gen types --lang typescript", "supabase gen types --local",
        "supabase gen types --local --lang typescript", "supabase gen signing-key",
        "supabase gen bearer-jwt", "bun run db:start", "bun run db:stop", "bun run db:status",
        "bun run db:reset", "bun run db:types", "bun run verify",
    ],
)

