    pattern = [["bunx", "npx"], "supabase", ["backups", "bootstrap", "branches", "config", "domains", "encryption", "link", "network-bans", "network-restrictions", "notebooks", "orgs", "postgres-config", "projects", "pull", "secrets", "snippets", "ssl-enforcement", "sso", "vanity-subdomains"]],
